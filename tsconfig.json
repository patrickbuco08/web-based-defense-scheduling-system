{
    "compilerOptions": {
      "jsx": "react-jsx",
      "moduleResolution": "Bundler",
      "module": "ESNext",
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "baseUrl": ".",
      "paths": { "@/*": ["resources/js/*"] },
      "strict": true,
      "allowJs": true,
      "noEmit": true,
      "skipLibCheck": true
    },
    "include": ["resources/js", "resources/**/*.d.ts", "vite-env.d.ts"]
  }